# ===================================================
# 2nd Nikah - DigitalOcean Production Environment (.env)
# ===================================================

# 1. Database Connection (MySQL / MariaDB on DigitalOcean Droplet or Managed Database)
# Format: mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME
DATABASE_URL="mysql://nikha_user:YourStrongPassword123!@127.0.0.1:3306/2ndnikha_db"

# 2. Application Base URL (Domain or Droplet IP)
# Example: https://2ndnikah.com or http://165.227.xx.xx
NEXT_PUBLIC_BASE_URL="https://2ndnikah.com"

# 3. Next.js Environment & Security
NODE_ENV="production"
JWT_SECRET="YourSuperSecretJWTSigningKey64CharsOrMoreGenerateWithOpenSSL"

# 4. SSLCommerz Payment Gateway (Live Credentials)
NEXT_PUBLIC_PAYMENT_GATEWAY="sslcommerz"
NEXT_PUBLIC_SSLCOMMERZ_STORE_ID="ndnikah0live"
SSLCOMMERZ_STORE_PASSWORD="6AA67B2A4DD6B64213"
NEXT_PUBLIC_SSLCOMMERZ_IS_LIVE=true

# (Optional Sandbox Mode during initial setup testing):
# NEXT_PUBLIC_SSLCOMMERZ_STORE_ID="testbox"
# SSLCOMMERZ_STORE_PASSWORD="gw_testbox_pass"
# NEXT_PUBLIC_SSLCOMMERZ_IS_LIVE=false

# 5. Admin Initial Setup
ADMIN_EMAIL="admin@2ndnikah.com"
