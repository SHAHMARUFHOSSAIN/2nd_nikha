# ===================================================
# DigitalOcean PRODUCTION Environment Template
# Copy to .env.local on your droplet and fill real values.
# NEVER commit this file with real values.
# ===================================================

# 1. Database Connection (DigitalOcean Managed MySQL or droplet MySQL)
# Keep server-side only. NEVER expose to client.
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME?connection_limit=5"

# 2. Application Base URLs
NEXT_PUBLIC_BASE_URL="https://2ndnikah.com"
NEXT_PUBLIC_APP_URL="https://2ndnikah.com"

# 3. Environment
NODE_ENV="production"

# 4. Server-side Auth Secret (openssl rand -base64 32)
JWT_SECRET="REPLACE_WITH_32_BYTE_RANDOM_SECRET"
JWT_EXPIRES_IN="7d"

# 5. SSLCommerz (LIVE)
NEXT_PUBLIC_PAYMENT_GATEWAY="sslcommerz"
NEXT_PUBLIC_SSLCOMMERZ_STORE_ID="FILL_STORE_ID"
# Server-side only — never make this NEXT_PUBLIC_
SSLCOMMERZ_STORE_PASSWORD="FILL_STORE_PASSWORD"
NEXT_PUBLIC_SSLCOMMERZ_IS_LIVE=true

# 6. Admin bootstrap account (created by seed script)
ADMIN_EMAIL="admin@2ndnikah.com"
ADMIN_INITIAL_PASSWORD="FILL_STRONG_PASSWORD"
# 7. Email verification delivery (SMTP). Email is NOT sent unless SMTP is
# configured; in development a dev-log transport is used instead and the
# verification flow is fully testable. Users are never auto-marked verified.
EMAIL_FROM="2nd Nikah <no-reply@2ndnikah.com>"
EMAIL_SERVER="smtp.yourprovider.com"
EMAIL_PORT="587"
EMAIL_SECURE="false"
EMAIL_USER="FILL_SMTP_USERNAME"
EMAIL_PASSWORD="FILL_SMTP_PASSWORD"

# Public base URL used to build verification links in emails.
NEXT_PUBLIC_APP_URL="https://www.2ndnikah.com"
